# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: bypasses RLS. Used for posts/replies/matches writes.
SUPABASE_SECRET_KEY=

# "mock" (default) serves shared/mock_match*.json; "live" calls /api/match. Flip at Sync 1.
NEXT_PUBLIC_MATCH_MODE=mock

# Muse Spark: entry analysis, passage tagging, echoing phrase, reasons, scrub, moderate. Server only.
MUSE_SPARK_API_KEY=
# Muse voice transcription for audio journaling. Server only; audio is never stored.
MUSE_TRANSCRIBE_API_KEY=

# Optional last-resort fallback, used only after every Muse Spark id has failed.
OPENAI_API_KEY=

# Seed scripts only (scripts/seed-*.mts): the demo account and the cast accounts' password.
DEMO_EMAIL=
DEMO_PASSWORD=
